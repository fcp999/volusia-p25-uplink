# Copy to .env and adjust. All values are optional; compose has defaults.

# sweep | channel | calib
MODE=sweep

# HackRF One serial (hackrf_info -> "Serial number:")
HACKRF_SERIAL=0000000000000000406464c82346594b

# Gain. Keep AMP=0 at 800 MHz: public-safety downlinks at 854-861 MHz are
# close enough to overload the front end.
LNA=32
VGA=22
AMP=0

# Sweep resolution and peak detection
BIN_HZ=2445
PEAK_HEIGHT_DB=4.0

# channel mode only
DWELL=2
ROUNDS=5

# Optional CSV output inside the container (/app/logs is mounted to ./logs)
# CSV=/app/logs/detections.csv

TZ=America/New_York
